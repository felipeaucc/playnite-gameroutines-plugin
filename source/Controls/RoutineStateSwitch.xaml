<UserControl x:Class="GameRoutines.RoutineStateSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameRoutines"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="GameRoutinesRoutineStateSwitchFallbackStyle"
               TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="SwitchTrack"
                                    Width="32"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Ellipse x:Name="SwitchThumb"
                                         Width="8"
                                         Height="8"
                                         Margin="3"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="BorderBrush"
                                        Value="{DynamicResource GlyphBrush}" />
                                <Setter TargetName="SwitchThumb"
                                        Property="Fill"
                                        Value="{DynamicResource GlyphBrush}" />
                                <Setter TargetName="SwitchThumb"
                                        Property="HorizontalAlignment"
                                        Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="BorderBrush"
                                        Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="SwitchThumb"
                                        Property="Fill"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack"
                                        Property="BorderBrush"
                                        Value="{DynamicResource GlyphBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ToggleButton x:Name="Switch"
                  MinWidth="42"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type local:RoutineStateSwitch}}, Mode=OneWay}"
                  Command="{Binding Command, RelativeSource={RelativeSource AncestorType={x:Type local:RoutineStateSwitch}}}"
                  Style="{DynamicResource GameRoutinesRoutineStateSwitchStyle}"
                  ToolTip="{Binding ToolTipText, RelativeSource={RelativeSource AncestorType={x:Type local:RoutineStateSwitch}}}"
                  Click="Switch_Click" />
</UserControl>
