<UserControl x:Class="GameRoutines.RoutineAutoCompletionToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameRoutines"
             Width="28"
             Height="30"
             Focusable="False">
    <ToggleButton x:Name="AutomaticCompletionButton"
                  Width="20"
                  Height="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Focusable="False"
                  ClipToBounds="False"
                  Background="Transparent"
                  BorderThickness="0"
                  IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type local:RoutineAutoCompletionToggle}}, Mode=OneWay}"
                  Command="{Binding Command, RelativeSource={RelativeSource AncestorType={x:Type local:RoutineAutoCompletionToggle}}}"
                  ToolTip="{Binding ToolTipText, RelativeSource={RelativeSource AncestorType={x:Type local:RoutineAutoCompletionToggle}}}"
                  Click="AutomaticCompletionButton_Click">
        <ToggleButton.Template>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
                <Border Background="Transparent" ClipToBounds="False">
                    <Canvas Width="20" Height="20" ClipToBounds="False">
                        <Viewbox Width="18"
                                 Height="18"
                                 Canvas.Left="0"
                                 Canvas.Top="1">
                            <TextBlock x:Name="RepeatIcon"
                                       Text="&#xE895;"
                                       Foreground="{DynamicResource ControlHoverBorderBrush}"
                                       Style="{DynamicResource IconFontStyle}" />
                        </Viewbox>
                        <Border Width="12"
                                Height="12"
                                Canvas.Left="12"
                                Canvas.Top="16"
                                ClipToBounds="False"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                CornerRadius="6">
                            <Grid ClipToBounds="False">
                                <Viewbox Width="8"
                                         Height="8"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         ClipToBounds="False">
                                    <Path x:Name="AutomaticCompletionOffIcon"
                                          Data="M1,1 L7,7 M7,1 L1,7"
                                          Stroke="#80FFFFFF"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.1" />
                                </Viewbox>
                                <Viewbox Width="11"
                                         Height="11"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         ClipToBounds="False">
                                    <TextBlock x:Name="AutomaticCompletionOnIcon"
                                               Text="&#xE73E;"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource ControlHoverBorderBrush}"
                                               Style="{DynamicResource IconFontStyle}"
                                               Visibility="Collapsed" />
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Canvas>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="AutomaticCompletionOffIcon"
                                Property="Visibility"
                                Value="Collapsed" />
                        <Setter TargetName="AutomaticCompletionOnIcon"
                                Property="Visibility"
                                Value="Visible" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Opacity" Value="0.65" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ToggleButton.Template>
    </ToggleButton>
</UserControl>
