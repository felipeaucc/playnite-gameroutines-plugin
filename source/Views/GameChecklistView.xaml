<UserControl x:Class="GameRoutines.GameChecklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameRoutines"
             Foreground="{DynamicResource TextBrush}">
    <local:MultiRoutineChecklistView ShowGameHeader="True"
                                     ShowPopOutAllButton="{Binding ShowOpenWindowButton, RelativeSource={RelativeSource AncestorType={x:Type local:GameChecklistView}}}"
                                     ShowNewChecklistButton="{Binding ShowNewChecklistButton, RelativeSource={RelativeSource AncestorType={x:Type local:GameChecklistView}}}"
                                     ShowDeleteChecklistButtons="{Binding ShowDeleteChecklistButtons, RelativeSource={RelativeSource AncestorType={x:Type local:GameChecklistView}}}"
                                     ShowRoutinePopOutButtons="{Binding ShowRoutinePopOutButtons, RelativeSource={RelativeSource AncestorType={x:Type local:GameChecklistView}}}" />
</UserControl>
