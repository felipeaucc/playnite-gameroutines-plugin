<UserControl x:Class="GameRoutines.RoutineScheduleEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameRoutines"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <local:CadenceDisplayConverter x:Key="CadenceDisplayConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding LabelColumnWidth, RelativeSource={RelativeSource AncestorType={x:Type local:RoutineScheduleEditor}}}" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="160" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Margin="0,9,10,0"
                   VerticalAlignment="Center"
                   Text="Reset schedule" />
        <ComboBox Grid.Column="1"
                  Width="150"
                  Height="30"
                  Margin="0,9,0,0"
                  Padding="6,3"
                  BorderThickness="1"
                  HorizontalAlignment="Left"
                  VerticalContentAlignment="Center"
                  ItemsSource="{Binding ResetCadences, RelativeSource={RelativeSource AncestorType={x:Type local:RoutineScheduleEditor}}}"
                  SelectedItem="{Binding ResetCadence, Mode=TwoWay}"
                  SelectionChanged="ScheduleComboBox_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource CadenceDisplayConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Column="2"
                   Margin="16,9,14,0"
                   VerticalAlignment="Center"
                   Text="Start date">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResetCadence}" Value="{x:Static local:ResetCadence.BiWeekly}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <DatePicker Grid.Column="3"
                    Width="150"
                    Height="30"
                    Margin="0,9,0,0"
                    HorizontalAlignment="Left"
                    SelectedDate="{Binding BiWeeklyResetStartingDate, Mode=TwoWay}"
                    SelectedDateChanged="StartingDatePicker_SelectedDateChanged">
            <DatePicker.Resources>
                <Style TargetType="{x:Type DatePickerTextBox}"
                       BasedOn="{StaticResource {x:Type DatePickerTextBox}}">
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </DatePicker.Resources>
            <DatePicker.Style>
                <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResetCadence}" Value="{x:Static local:ResetCadence.BiWeekly}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DatePicker.Style>
        </DatePicker>

        <TextBlock Grid.Row="1"
                   Margin="0,9,10,0"
                   VerticalAlignment="Center"
                   Text="Reset day">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResetCadence}" Value="{x:Static local:ResetCadence.Weekly}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Width="150"
                  Height="30"
                  Margin="0,9,0,0"
                  Padding="6,3"
                  BorderThickness="1"
                  HorizontalAlignment="Left"
                  VerticalContentAlignment="Center"
                  ItemsSource="{Binding DaysOfWeek, RelativeSource={RelativeSource AncestorType={x:Type local:RoutineScheduleEditor}}}"
                  SelectedItem="{Binding ResetDay, Mode=TwoWay}"
                  SelectionChanged="ResetDayComboBox_SelectionChanged">
            <ComboBox.Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResetCadence}" Value="{x:Static local:ResetCadence.Weekly}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
        </ComboBox>

        <TextBlock Grid.Row="2"
                   Margin="0,9,10,0"
                   VerticalAlignment="Center"
                   Text="Reset time">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResetCadence}" Value="{x:Static local:ResetCadence.Never}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Margin="0,9,0,0"
                    Orientation="Horizontal">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResetCadence}" Value="{x:Static local:ResetCadence.Never}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBox Width="72"
                     Height="30"
                     MaxLength="5"
                     Padding="5,3"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"
                     TextAlignment="Center"
                     Text="{Binding ResetTime, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                     PreviewKeyDown="TimeTextBox_PreviewKeyDown"
                     PreviewLostKeyboardFocus="TimeTextBox_PreviewLostKeyboardFocus"
                     TextChanged="TimeTextBox_TextChanged"
                     DataObject.Pasting="TimeTextBox_Pasting" />
            <TextBlock Margin="8,2,0,0"
                       Opacity="0.7"
                       Text="24-hour HH:mm, local time" />
        </StackPanel>
    </Grid>
</UserControl>
