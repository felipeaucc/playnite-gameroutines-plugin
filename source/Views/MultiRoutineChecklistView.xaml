<UserControl x:Class="GameRoutines.MultiRoutineChecklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameRoutines"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../GameRoutinesIconResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ChecklistHeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource ControlHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowGameHeader, RelativeSource={RelativeSource AncestorType={x:Type local:MultiRoutineChecklistView}}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock FontSize="20"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding GameName, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
                <Button Command="{Binding AddRoutineCommand}"
                        ToolTip="New Checklist">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChecklistHeaderIconButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNewChecklistButton, RelativeSource={RelativeSource AncestorType={x:Type local:MultiRoutineChecklistView}}}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="10"
                          Height="10"
                          Data="{StaticResource GameRoutinesPlusGeometry}"
                          Style="{StaticResource GameRoutinesButtonIconStyle}" />
                </Button>
            </StackPanel>
            <Button Grid.Column="1"
                    Padding="10,4"
                    Command="{Binding OpenAllChecklistsCommand}"
                    ToolTip="Open all routine checklists in their own window.">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPopOutAllButton, RelativeSource={RelativeSource AncestorType={x:Type local:MultiRoutineChecklistView}}}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <Path Margin="0,0,7,0"
                          Data="{StaticResource GameRoutinesPopOutGeometry}"
                          Style="{StaticResource GameRoutinesButtonIconStyle}" />
                    <TextBlock Text="Pop-out All Checklists" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding RoutineCards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:RoutineChecklistCard ShowPopOutButton="{Binding ShowRoutinePopOutButtons, RelativeSource={RelativeSource AncestorType={x:Type local:MultiRoutineChecklistView}}}"
                                                        ShowDeleteButton="{Binding ShowDeleteChecklistButtons, RelativeSource={RelativeSource AncestorType={x:Type local:MultiRoutineChecklistView}}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.7"
                           Text="No routines configured."
                           TextAlignment="Center"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasRoutines}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
