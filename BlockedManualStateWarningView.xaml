<UserControl x:Class="GameRoutines.BlockedManualStateWarningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock MaxWidth="440"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Text="Automatic checklist completion is enabled for this game. Its task status is controlled by the checklist. Turn off automatic completion in Game Routines settings to change the task status manually."
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="DontShowAgainCheckBox"
                      VerticalAlignment="Center"
                      Content="Don't show this again" />
            <Button Grid.Column="1"
                    Width="84"
                    Padding="12,5"
                    VerticalAlignment="Center"
                    IsCancel="True"
                    IsDefault="True"
                    Content="OK"
                    Click="OkButton_Click" />
        </Grid>
    </Grid>
</UserControl>
